# MyPersonalPensieve Backend 配置（桌面端嵌入式版本）
# 大部分配置有默认值，桌面端运行时由 Electron 通过环境变量注入。

# 数据目录（SQLite 数据库、ChromaDB 向量、上传文件都存这里）
# 桌面端默认：可执行文件同级 data 目录
PENSIEVE_DATA_DIR=

# SQLite 数据库文件路径（留空则使用 data_dir/pensieve.db）
SQLITE_PATH=

# ChromaDB 持久化目录（留空则使用 data_dir/chroma）
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION_NAME=pensieve_memories

# LLM Provider（支持 openai / deepseek / zhipu）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# DeepSeek 示例：
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat

# 智谱 GLM 示例：
# LLM_PROVIDER=zhipu
# LLM_API_KEY=your-zhipu-key
# LLM_MODEL=glm-4-flash

# 上传目录（留空则使用 data_dir/uploads）
UPLOAD_DIR=

# 服务器
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DEBUG=false
# MyPersonalPensieve Backend 配置（桌面端嵌入式版本）
# 大部分配置有默认值，桌面端运行时由 Electron 通过环境变量注入。

# 数据目录（SQLite 数据库、ChromaDB 向量、上传文件都存这里）
# 桌面端默认：可执行文件同级 data 目录
PENSIEVE_DATA_DIR=

# SQLite 数据库文件路径（留空则使用 data_dir/pensieve.db）
SQLITE_PATH=

# ChromaDB 持久化目录（留空则使用 data_dir/chroma）
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION_NAME=pensieve_memories

# OpenAI（用于嵌入和实体抽取，可选——不配置则跳过相关功能）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 上传目录（留空则使用 data_dir/uploads）
UPLOAD_DIR=

# 服务器
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DEBUG=false
